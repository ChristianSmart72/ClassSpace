# Required — app will crash at startup if missing
JWT_SECRET=openssl rand -hex 32   # Generate: openssl rand -hex 32
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=                  # Generate: npx web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=                 # (same command, keep secret)
TURSO_DB_URL=                      # Your Turso database URL, e.g. libsql://classspace-username.turso.io
TURSO_DB_TOKEN=                    # Generate: turso db tokens create classspace
UPLOADTHING_SECRET=                 # From uploadthing.com dashboard — API Keys → Secret Key

# Optional
PORT=3001
HOST=0.0.0.0
NODE_ENV=development               # Set to 'production' on Render
